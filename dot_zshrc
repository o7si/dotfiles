# fzf & fzfp
if [[ -n $TMUX_PANE ]] && (( $+commands[tmux] )) && (( $+commands[fzfp] )); then
  # fallback to normal fzf if current session name is `floating`
  export TMUX_POPUP_NESTED_FB='test $(tmux display -pF "#{==:#S,floating}") == 1'

  export TMUX_POPUP_WIDTH=80%
fi

_fzf_can_use_popup() {
  command -v tmux >/dev/null 2>&1 || return 1
  command -v fzfp >/dev/null 2>&1 || return 1
  command -v fzf  >/dev/null 2>&1 || return 1
  [[ -n "$TMUX_PANE" ]] || return 1
  tmux display-message -p '#{client_name}' >/dev/null 2>&1 || return 1
  local session_name
  session_name="$(tmux display-message -p '#S' 2>/dev/null)" || return 1
  [[ "$session_name" != "floating" ]] || return 1
  return 0
}

fzf() {
  if _fzf_can_use_popup; then
    command fzfp "$@"
  else
    command fzf "$@"
  fi
}

# yazi
function y() {
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
  yazi "$@" --cwd-file="$tmp"
  if cwd="$(cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
    cd -- "$cwd"
  fi
  rm -f -- "$tmp"
}
